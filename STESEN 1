    </div>

    <!-- Proximity Interaction Hint -->
    <div id="interact-prompt" class="hidden absolute bottom-24 left-1/2 -translate-x-1/2 bg-amber-500 text-gray-950 font-bold px-6 py-2.5 rounded-full shadow-xl border-2 border-amber-300 flex items-center gap-2 animate-bounce z-20 pointer-events-none text-base md:text-lg">
        <i class="fa-solid fa-hand-pointer text-xl"></i>
        <span>Buka Peti Sains (Tekan E / Ketik Skrin)</span>
    </div>

    <!-- Mobile Virtual Controls -->
    <div id="mobile-controls" class="block md:hidden absolute inset-0 pointer-events-none z-30">
        <!-- Virtual Joystick Area (Left Half) -->
        <div id="joystick-zone" class="absolute bottom-6 left-6 w-32 h-32 rounded-full bg-white/10 border-2 border-white/30 backdrop-blur-sm pointer-events-auto touch-zone flex items-center justify-center">
            <div id="joystick-knob" class="w-14 h-14 rounded-full bg-emerald-500/80 border-2 border-emerald-300 shadow-md transform transition-transform"></div>
        </div>

        <!-- Jump & Interact Buttons (Right Side) -->
        <div class="absolute bottom-6 right-6 flex flex-col gap-3 pointer-events-auto">
            <button id="btn-mobile-jump" class="w-16 h-16 rounded-2xl bg-amber-500/90 active:bg-amber-600 border-2 border-amber-300 text-gray-950 font-black text-xl flex items-center justify-center shadow-lg active:scale-95 transition-transform touch-zone">
