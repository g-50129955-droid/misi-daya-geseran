    <!-- HUD Overlay Top Bar -->
    <div id="hud-top" class="absolute top-3 left-3 right-3 flex justify-between items-start pointer-events-none z-20 gap-2">
        <!-- Player Info & Score -->
        <div class="bg-gray-900/85 border-2 border-emerald-500/80 rounded-2xl p-3 backdrop-blur-md shadow-lg flex items-center gap-4 pointer-events-auto">
