            <button id="btn-mobile-interact" class="w-16 h-16 rounded-2xl bg-emerald-500/90 active:bg-emerald-600 border-2 border-emerald-300 text-white font-black text-xl flex items-center justify-center shadow-lg active:scale-95 transition-transform touch-zone">
