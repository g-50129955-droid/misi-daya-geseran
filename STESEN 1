                    <span id="score-text">0</span> <span class="text-xs font-normal text-gray-400">/ 500</span>
                </div>
            </div>
        </div>

        <!-- Quest Progress Tracker -->
        <div class="bg-gray-900/85 border-2 border-amber-500/80 rounded-2xl p-3 backdrop-blur-md shadow-lg flex items-center gap-3 pointer-events-auto">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400 flex items-center justify-center text-amber-400 text-xl font-bold">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <div>
                <div class="text-xs text-gray-400 uppercase font-pixel tracking-wider">Peti Terkumpul</div>
                <div class="text-xl font-bold text-amber-300">
