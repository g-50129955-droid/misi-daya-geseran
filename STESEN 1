    <!-- Start Game Modal Overlay -->
    <div id="start-overlay" class="absolute inset-0 bg-gray-950/90 backdrop-blur-lg flex items-center justify-center p-4 z-50">
        <div class="max-w-xl w-full bg-gray-900 border-4 border-emerald-500 rounded-3xl p-6 md:p-8 text-center shadow-2xl relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-36 h-36 bg-emerald-500/20 rounded-full blur-2xl"></div>
            
