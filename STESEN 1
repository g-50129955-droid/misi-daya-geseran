    <!-- Victory Screen Modal Overlay -->
    <div id="victory-modal" class="hidden absolute inset-0 bg-gray-950/90 backdrop-blur-lg flex items-center justify-center p-4 z-50">
        <div class="max-w-xl w-full bg-gray-900 border-4 border-emerald-400 rounded-3xl p-6 md:p-8 text-center shadow-2xl relative">
            <div class="w-20 h-20 mx-auto mb-3 bg-amber-500/20 border-2 border-amber-400 rounded-2xl flex items-center justify-center text-amber-400 text-4xl shadow-lg">
